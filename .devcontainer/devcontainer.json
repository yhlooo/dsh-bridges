{
  "name": "dsh-bridges-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  // Run the image CMD (dsh web autostart + keep-alive) as PID 1 instead of
  // the devcontainer CLI's default keep-alive command. Processes spawned by
  // lifecycle hooks get killed when their exec session ends, but PID 1's
  // children survive, which is what keeps dsh running.
  "overrideCommand": false,
  "containerEnv": {
    "SHELL": "/usr/bin/zsh"
  },
  // Persist the dsh user-data root (~/.dsh: profiles, storages, model config,
  // sessions, workspaces) in a named volume so it survives container rebuilds.
  "mounts": [
    {
      "source": "dsh-bridges-dsh-home",
      "target": "/root/.dsh",
      "type": "volume"
    }
  ],
  // dsh web serves the DeepSeek Harness Web UI on 127.0.0.1:3080
  "forwardPorts": [3080],
  "portsAttributes": {
    "3080": {
      "label": "DSH Web UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  }
}
